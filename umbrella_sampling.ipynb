"""
Fase 3: Muestreo Termodinámico (Umbrella Sampling) y Registro de Coordenadas.
Dependencias: OpenMM, ParmEd, NumPy.
Descripción: Ejecución de trayectorias independientes confinadas espacialmente
mediante potenciales armónicos estacionarios. Se registra la evolución 
temporal de la distancia interdimérica para la posterior reconstrucción del 
Potencial de Fuerza Media (PMF) mediante el Análisis de Histogramas Ponderados (WHAM).
"""

import os
import glob
import numpy as np
import openmm as mm
import openmm.app as app
from openmm import unit
import parmed as pmd

# ------------------------------------------------------------------------------
# 1. DEFINICIÓN DEL ESPACIO MUESTRAL
# ------------------------------------------------------------------------------
POLIENOS = ['AmB', 'Nat', 'Nys', 'A21', 'Anf']
CONFIGURACIONES = ['HHP', 'HHA', 'HTA', 'HTP']
RUTA_RAIZ = '/content/drive/MyDrive'

# ------------------------------------------------------------------------------
# 2. PARÁMETROS DEL MUESTREO (Ensamble NVT)
# ------------------------------------------------------------------------------
TEMPERATURA = 310.0 * unit.kelvin
FRICCION = 1.0 / unit.picosecond              # Reducción de fricción para muestreo ergódico
PASO_TIEMPO = 2.0 * unit.femtosecond          # Integración estándar 
K_RESORTE = 1000.0 * unit.kilojoule_per_mole / (unit.nanometer**2)
PASOS_EQUILIBRACION = 50000                   # 100 ps de termalización por ventana
PASOS_PRODUCCION = 500000                     # 1 ns de producción por ventana
FRECUENCIA_MUESTREO = 500                     # Registro de distancia cada 1 ps

# ------------------------------------------------------------------------------
# 3. IDENTIFICACIÓN DE GRUPOS ATÓMICOS
# ------------------------------------------------------------------------------
def obtener_indices_monomeros(topologia):
    """
    Aislamiento de los índices atómicos correspondientes a los monómeros 
    para la evaluación del Centro de Masa (COM).
    """
    indices_A, indices_B = [], []
    cadenas = list(topologia.chains())
    for atomo in cadenas[0].atoms(): indices_A.append(atomo.index)
    for atomo in cadenas[1].atoms(): indices_B.append(atomo.index)
    return indices_A, indices_B

# ------------------------------------------------------------------------------
# 4. EJECUCIÓN DEL MUESTREO POR VENTANA
# ------------------------------------------------------------------------------
def ejecutar_fase_umbrella(polieno, config):
    ruta_topologia = f"{RUTA_RAIZ}/{polieno}_Tesis_Master/Topologias_{config}"
    ruta_smd = f"{RUTA_RAIZ}/{polieno}_Tesis_Master/SMD_{config}"
    ruta_us = f"{RUTA_RAIZ}/{polieno}_Tesis_Master/US_Data_{config}"
    
    archivo_top = f"{ruta_topologia}/sistema_solvatado.top"
    os.makedirs(ruta_us, exist_ok=True)
    
    if not os.path.exists(archivo_top):
        return

    # Listado de ventanas extraídas de la trayectoria SMD
    archivos_ventanas = sorted(glob.glob(f"{ruta_smd}/ventana_*.pdb"))
    if not archivos_ventanas:
        return
        
    estructura = pmd.load_file(archivo_top)
    archivo_metadata = open(f"{ruta_us}/metadata.dat", "w")
    
    for idx_ventana, archivo_pdb in enumerate(archivos_ventanas):
        # Extracción de la distancia objetivo desde el nombre del archivo
        nombre_base = os.path.basename(archivo_pdb).replace('.pdb', '').replace('ventana_', '')
        distancia_objetivo = float(nombre_base.replace('_', '.'))
        
        pdb = app.PDBFile(archivo_pdb)
        sistema = estructura.createSystem(
            nonbondedMethod=app.PME, 
            nonbondedCutoff=1.2*unit.nanometer,
            constraints=app.HBonds, 
            rigidWater=True
        )
        
        # Aplicación del potencial armónico de restricción (Bias estático)
        fuerza_restriccion = mm.CustomCentroidBondForce(2, "0.5*k*(distance(g1,g2)-r0)^2")
        fuerza_restriccion.addGlobalParameter("k", K_RESORTE)
        fuerza_restriccion.addGlobalParameter("r0", distancia_objetivo)
        
        indices_A, indices_B = obtener_indices_monomeros(pdb.topology)
        grupo1 = fuerza_restriccion.addGroup(indices_A)
        grupo2 = fuerza_restriccion.addGroup(indices_B)
        fuerza_restriccion.addBond([grupo1, grupo2])
        sistema.addForce(fuerza_restriccion)
        
        integrador = mm.LangevinIntegrator(TEMPERATURA, FRICCION, PASO_TIEMPO)
        plataforma = mm.Platform.getPlatformByName('CUDA')
        propiedades = {'Precision': 'single'}
        
        simulacion = app.Simulation(pdb.topology, sistema, integrador, plataforma, propiedades)
        simulacion.context.setPositions(pdb.positions)
        
        # Equilibración local en el pozo de restricción
        simulacion.context.setVelocitiesToTemperature(TEMPERATURA)
        simulacion.step(PASOS_EQUILIBRACION)
        
        # Producción y recolección de trayectorias (Coordenada de Reacción)
        archivo_salida = f"{ruta_us}/dist_{idx_ventana:02d}.dat"
        with open(archivo_salida, 'w') as f:
            for paso in range(0, PASOS_PRODUCCION, FRECUENCIA_MUESTREO):
                simulacion.step(FRECUENCIA_MUESTREO)
                estado = simulacion.context.getState(getPositions=True)
                posiciones = estado.getPositions(asNumpy=True)
                
                # Evaluación instantánea del COM
                com_A = np.mean(posiciones[indices_A, :].value_in_unit(unit.nanometer), axis=0)
                com_B = np.mean(posiciones[indices_B, :].value_in_unit(unit.nanometer), axis=0)
                dist_actual = np.linalg.norm(com_A - com_B)
                
                f.write(f"{paso}\t{dist_actual:.4f}\n")
                
        # Registro en el archivo de metadatos requerido para las ecuaciones de paridad de WHAM
        archivo_metadata.write(f"dist_{idx_ventana:02d}.dat\t{distancia_objetivo:.4f}\t{K_RESORTE.value_in_unit(unit.kilojoule_per_mole / (unit.nanometer**2)):.1f}\n")
        
    archivo_metadata.close()

# Ejecución de muestreo de paraguas sobre el espacio paramétrico total
for polieno in POLIENOS:
    for config in CONFIGURACIONES:
        ejecutar_fase_umbrella(polieno, config)
