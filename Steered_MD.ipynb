"""
Fase 2: Dinámica Molecular Dirigida (Steered Molecular Dynamics).
Dependencias: OpenMM, ParmEd, NumPy.
Descripción: Aplicación de un potencial armónico de tracción sobre los centros de masa (COM)
de ambos monómeros para explorar la coordenada de reacción. Se utiliza un régimen de alta 
fricción para amortiguar fluctuaciones inerciales severas durante la tracción.
"""

import os
import numpy as np
import openmm as mm
import openmm.app as app
from openmm import unit
import parmed as pmd

# ------------------------------------------------------------------------------
# 1. DEFINICIÓN DEL ESPACIO MUESTRAL
# ------------------------------------------------------------------------------
POLIENOS = ['AmB', 'Nat', 'Nys', 'A21', 'Anf']
CONFIGURACIONES = ['HHP', 'HHA', 'HTA', 'HTP']
RUTA_RAIZ = '/content/drive/MyDrive'

# ------------------------------------------------------------------------------
# 2. PARÁMETROS MECÁNICOS Y TERMODINÁMICOS DE TRACCIÓN
# ------------------------------------------------------------------------------
TEMPERATURA = 310.0 * unit.kelvin
FRICCION = 5.0 / unit.picosecond              # Régimen sobreamortiguado (Modo Tanque)
PASO_TIEMPO = 1.0 * unit.femtosecond          # Integración fina para estabilidad numérica
K_RESORTE = 1000.0 * unit.kilojoule_per_mole / (unit.nanometer**2)
VELOCIDAD_TRACCION = 0.001 * unit.nanometer / unit.picosecond
DISTANCIA_FINAL = 3.5 * unit.nanometer

# ------------------------------------------------------------------------------
# 3. IDENTIFICACIÓN DE GRUPOS ATÓMICOS
# ------------------------------------------------------------------------------
def obtener_indices_monomeros(topologia):
    """
    Segmenta los índices atómicos basándose en la topología concatenada.
    Asume que el monómero A y el monómero B son las dos primeras moléculas del sistema,
    excluyendo el solvente y los iones.
    """
    indices_A = []
    indices_B = []
    cadenas = list(topologia.chains())
    
    # La topología procesada ubica los monómeros en las primeras dos cadenas
    for atomo in cadenas[0].atoms():
        indices_A.append(atomo.index)
    for atomo in cadenas[1].atoms():
        indices_B.append(atomo.index)
        
    return indices_A, indices_B

# ------------------------------------------------------------------------------
# 4. FUNCIÓN PRINCIPAL DE TRACCIÓN
# ------------------------------------------------------------------------------
def ejecutar_fase_smd(polieno, config):
    ruta_trabajo = f"{RUTA_RAIZ}/{polieno}_Tesis_Master/Topologias_{config}"
    archivo_pdb = f"{ruta_trabajo}/estado_relajado_{config}.pdb"
    archivo_top = f"{ruta_trabajo}/sistema_solvatado.top"
    
    if not (os.path.exists(archivo_pdb) and os.path.exists(archivo_top)):
        return

    # Carga de coordenadas equilibradas de la Fase 1
    pdb = app.PDBFile(archivo_pdb)
    estructura = pmd.load_file(archivo_top)
    
    sistema = estructura.createSystem(
        nonbondedMethod=app.PME, 
        nonbondedCutoff=1.2*unit.nanometer,
        constraints=app.HBonds, 
        rigidWater=True
    )
    
    # Definición del potencial armónico sobre el centro de masa (COM)
    # Ecuación del potencial de sesgo: V(\xi) = 0.5 * k * (\xi - \xi_0)^2
    fuerza_traccion = mm.CustomCentroidBondForce(2, "0.5*k*(distance(g1,g2)-r0)^2")
    fuerza_traccion.addGlobalParameter("k", K_RESORTE)
    fuerza_traccion.addGlobalParameter("r0", 0.0) # r0 se actualizará dinámicamente
    
    indices_A, indices_B = obtener_indices_monomeros(pdb.topology)
    grupo1 = fuerza_traccion.addGroup(indices_A)
    grupo2 = fuerza_traccion.addGroup(indices_B)
    fuerza_traccion.addBond([grupo1, grupo2])
    sistema.addForce(fuerza_traccion)
    
    # Configuración del integrador Langevin para amortiguamiento térmico e inercial
    integrador = mm.LangevinIntegrator(TEMPERATURA, FRICCION, PASO_TIEMPO)
    plataforma = mm.Platform.getPlatformByName('CUDA')
    propiedades = {'Precision': 'single'}
    
    simulacion = app.Simulation(pdb.topology, sistema, integrador, plataforma, propiedades)
    simulacion.context.setPositions(pdb.positions)
    
    # Cálculo de la distancia inicial de los centros de masa
    estado_inicial = simulacion.context.getState(getPositions=True)
    posiciones = estado_inicial.getPositions(asNumpy=True)
    com_A = np.mean(posiciones[indices_A, :].value_in_unit(unit.nanometer), axis=0)
    com_B = np.mean(posiciones[indices_B, :].value_in_unit(unit.nanometer), axis=0)
    distancia_inicial = np.linalg.norm(com_A - com_B)
    
    simulacion.context.setParameter("r0", distancia_inicial)
    
    # --------------------------------------------------------------------------
    # 5. INTEGRACIÓN NUMÉRICA Y DESPLAZAMIENTO DEL POTENCIAL
    # --------------------------------------------------------------------------
    pasos_totales = int((DISTANCIA_FINAL.value_in_unit(unit.nanometer) - distancia_inicial) / 
                        VELOCIDAD_TRACCION.value_in_unit(unit.nanometer / unit.picosecond) / 
                        PASO_TIEMPO.value_in_unit(unit.picosecond))
    
    pasos_por_ciclo = 1000
    incremento_r0 = VELOCIDAD_TRACCION.value_in_unit(unit.nanometer / unit.picosecond) * \
                    (pasos_por_ciclo * PASO_TIEMPO.value_in_unit(unit.picosecond))
    
    ruta_smd = f"{RUTA_RAIZ}/{polieno}_Tesis_Master/SMD_{config}"
    os.makedirs(ruta_smd, exist_ok=True)
    
    reportero_dcd = app.DCDReporter(f"{ruta_smd}/traccion_smd_{config}.dcd", 5000)
    simulacion.reporters.append(reportero_dcd)
    
    # Iteración del parámetro dependiente del tiempo r0(t) = r_inicial + v*t
    r0_actual = distancia_inicial
    for i in range(int(pasos_totales / pasos_por_ciclo)):
        simulacion.step(pasos_por_ciclo)
        r0_actual += incremento_r0
        simulacion.context.setParameter("r0", r0_actual)
        
        # Extracción de configuraciones para Umbrella Sampling (cada 0.05 nm aprox)
        if i % 50 == 0:
            estado_ventana = simulacion.context.getState(getPositions=True)
            distancia_str = f"{r0_actual:.2f}".replace('.', '_')
            app.PDBFile.writeFile(simulacion.topology, estado_ventana.getPositions(), 
                                  open(f"{ruta_smd}/ventana_{distancia_str}.pdb", 'w'))

# Ejecución secuencial sobre el espacio muestral
for polieno in POLIENOS:
    for config in CONFIGURACIONES:
        ejecutar_fase_smd(polieno, config)
