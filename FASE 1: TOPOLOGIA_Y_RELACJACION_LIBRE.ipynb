"""
Fase 1: Relajación Libre y Estabilización Termodinámica de Dímeros Poliénicos.
Dependencias: OpenMM, ParmEd.
Descripción: Construcción del sistema, minimización profunda (tolerancia estricta)
y equilibración NVT/NPT iterativa para la disipación de repulsiones de Pauli.
"""

import os
import openmm as mm
import openmm.app as app
from openmm import unit
import parmed as pmd

# ------------------------------------------------------------------------------
# 1. DEFINICIÓN DEL ESPACIO MUESTRAL
# ------------------------------------------------------------------------------
POLIENOS = ['AmB', 'Nat', 'Nys', 'A21', 'Anf']
CONFIGURACIONES = ['HHP', 'HHA', 'HTA', 'HTP']
RUTA_RAIZ = '/content/drive/MyDrive'

# ------------------------------------------------------------------------------
# 2. PARÁMETROS TERMODINÁMICOS Y DE INTEGRACIÓN
# ------------------------------------------------------------------------------
TEMPERATURA = 310.0 * unit.kelvin             # Temperatura fisiológica
FRICCION = 5.0 / unit.picosecond              # Coeficiente de fricción alto para amortiguamiento
PASO_TIEMPO = 1.0 * unit.femtosecond          # Micro-stepping para alta estabilidad numérica
PRESIÓN = 1.0 * unit.bar                      # Presión estándar
TOLERANCIA_MIN = 1.0 * unit.kilojoule_per_mole / unit.nanometer

# Pasos de simulación
PASOS_NVT = 500000                            # 500 ps
PASOS_NPT = 500000                            # 500 ps
PASOS_PRODUCCION = 20000000                   # 20 ns de MD sin restricciones

def ejecutar_fase_relajacion(polieno, config):
    ruta_trabajo = f"{RUTA_RAIZ}/{polieno}_Tesis_Master/Topologias_{config}"
    os.makedirs(ruta_trabajo, exist_ok=True)
    
    archivo_gro = f"{ruta_trabajo}/sistema_solvatado.gro"
    archivo_top = f"{ruta_trabajo}/sistema_solvatado.top"
    
    if not (os.path.exists(archivo_gro) and os.path.exists(archivo_top)):
        print(f"Archivos topológicos no encontrados para {polieno}-{config}. Omitiendo.")
        return

    # --------------------------------------------------------------------------
    # 3. CONSTRUCCIÓN DE LA TOPOLOGÍA
    # --------------------------------------------------------------------------
    # ParmEd unifica la topología de GROMACS y los parámetros CHARMM36/CGenFF
    estructura = pmd.load_file(archivo_top, xyz=archivo_gro)
    
    sistema = estructura.createSystem(
        nonbondedMethod=app.PME, 
        nonbondedCutoff=1.2*unit.nanometer,
        constraints=app.HBonds, 
        rigidWater=True
    )
    
    # --------------------------------------------------------------------------
    # 4. CONFIGURACIÓN DEL INTEGRADOR Y TERMOSTATO/BAROSTATO
    # --------------------------------------------------------------------------
    # Integrador de Langevin para acoplamiento acoplado al baño térmico estocástico
    integrador = mm.LangevinIntegrator(TEMPERATURA, FRICCION, PASO_TIEMPO)
    
    # Inserción del Barostato de Monte Carlo para equilibración isotrópica (NPT)
    barostato = mm.MonteCarloBarostat(PRESIÓN, TEMPERATURA)
    sistema.addForce(barostato)
    
    plataforma = mm.Platform.getPlatformByName('CUDA')
    propiedades = {'Precision': 'single'}
    
    simulacion = app.Simulation(estructura.topology, sistema, integrador, plataforma, propiedades)
    simulacion.context.setPositions(estructura.positions)
    
    # --------------------------------------------------------------------------
    # 5. MINIMIZACIÓN ESTRICTA
    # --------------------------------------------------------------------------
    # Restricción de tolerancia a 1 kJ/mol/nm para forzar la resolución de contactos anómalos
    simulacion.minimizeEnergy(tolerance=TOLERANCIA_MIN, maxIterations=0)
    estado_min = simulacion.context.getState(getEnergy=True)
    
    # --------------------------------------------------------------------------
    # 6. EQUILIBRACIÓN NVT (Volumen Constante)
    # --------------------------------------------------------------------------
    # Generación de velocidades a partir de la distribución de Maxwell-Boltzmann
    simulacion.context.setVelocitiesToTemperature(TEMPERATURA)
    # Desactivación temporal del barostato para conservar el volumen durante NVT
    for idx, fuerza in enumerate(sistema.getForces()):
        if isinstance(fuerza, mm.MonteCarloBarostat):
            fuerza.setForceGroup(31) 
    simulacion.step(PASOS_NVT)
    
    # --------------------------------------------------------------------------
    # 7. EQUILIBRACIÓN NPT (Presión Constante)
    # --------------------------------------------------------------------------
    # Reactivación del barostato
    for idx, fuerza in enumerate(sistema.getForces()):
        if isinstance(fuerza, mm.MonteCarloBarostat):
            fuerza.setForceGroup(0)
    simulacion.step(PASOS_NPT)
    
    # --------------------------------------------------------------------------
    # 8. PRODUCCIÓN DE RELAJACIÓN LIBRE (Unrestrained MD)
    # --------------------------------------------------------------------------
    # Trayectoria diseñada para permitir el colapso del dímero a su pozo local real
    reportero_dcd = app.DCDReporter(f"{ruta_trabajo}/relajacion_{config}.dcd", 10000)
    reportero_log = app.StateDataReporter(f"{ruta_trabajo}/relajacion_{config}.log", 10000, 
                                          step=True, potentialEnergy=True, temperature=True, volume=True)
    
    simulacion.reporters.append(reportero_dcd)
    simulacion.reporters.append(reportero_log)
    
    simulacion.step(PASOS_PRODUCCION)
    
    # Guardado del estado fundamental relajado para la Fase 2 (Steered MD)
    posiciones_finales = simulacion.context.getState(getPositions=True).getPositions()
    app.PDBFile.writeFile(simulacion.topology, posiciones_finales, open(f"{ruta_trabajo}/estado_relajado_{config}.pdb", 'w'))

# Ejecución secuencial sobre todo el espacio muestral
for polieno in POLIENOS:
    for config in CONFIGURACIONES:
        ejecutar_fase_relajacion(polieno, config)
