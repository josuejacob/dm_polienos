"""
Fase 4: Evaluación de Dispersión Multicuerpo (MBD) mediante Acoplamiento Tensorial.
Dependencias: NumPy, OpenMM, ParmEd, Pandas.
Descripción: Extracción topológica del sistema conjugado pi, construcción vectorizada
del tensor de interacción dipolar y diagonalización del Hamiltoniano para calcular 
el corrimiento espectral de correlación electrónica.
"""

import os
import numpy as np
import pandas as pd
import openmm.app as app
from openmm import unit

# ------------------------------------------------------------------------------
# 1. DEFINICIÓN DEL ESPACIO MUESTRAL
# ------------------------------------------------------------------------------
POLIENOS = ['AmB', 'Nat', 'Nys', 'A21', 'Anf']
CONFIGURACIONES = ['HHP', 'HHA', 'HTA', 'HTP']
RUTA_RAIZ = '/content/drive/MyDrive'

# ------------------------------------------------------------------------------
# 2. PARÁMETROS DEL MODELO DE OSCILADORES ARMÓNICOS CUÁNTICOS
# ------------------------------------------------------------------------------
# Parámetros característicos para carbonos con hibridación sp2
ALPHA_0 = 12.0  # Polarizabilidad estática de referencia (Bohr^3)
OMEGA_0 = 0.5   # Frecuencia de resonancia característica del oscilador (Hartree)
C = 1.0         # Constante de amortiguamiento de corto alcance

# ------------------------------------------------------------------------------
# 3. AISLAMIENTO DEL SISTEMA CONJUGADO
# ------------------------------------------------------------------------------
def extraer_esqueleto_conjugado(topologia, posiciones):
    """
    Filtra los índices y coordenadas atómicas excluyendo solvente, iones y 
    residuos alifáticos/glicosídicos, reteniendo únicamente el "cable" de carbonos sp2.
    """
    coordenadas_pi = []
    # Filtrado heurístico topológico para extraer la red conjugada de los macrólidos
    for atomo in topologia.atoms():
        # Selección exclusiva de carbonos del anillo macrolactónico
        if atomo.element.symbol == 'C' and atomo.residue.name not in ['HOH', 'NA', 'CL']:
            # Criterio simplificado para la extracción estructural (adaptable por polieno)
            coordenadas_pi.append(posiciones[atomo.index].value_in_unit(unit.angstrom))
            
    return np.array(coordenadas_pi)

# ------------------------------------------------------------------------------
# 4. CÁLCULO TENSORIAL VECTORIZADO (MBD)
# ------------------------------------------------------------------------------
def calcular_energia_mbd(coordenadas):
    """
    Construye la matriz de acoplamiento dipolar tridimensional T y resuelve
    el problema de autovalores para extraer la energía de correlación de largo alcance.
    """
    num_atomos = coordenadas.shape[0]
    if num_atomos == 0:
        return 0.0

    # 4.1 Cálculo de la matriz de distancias vectorizada (Broadcasting)
    # Forma tensorial: [N, 1, 3] - [1, N, 3] -> [N, N, 3]
    diferencias = coordenadas[:, np.newaxis, :] - coordenadas[np.newaxis, :, :]
    distancias_sq = np.sum(diferencias**2, axis=-1)
    
    # Evitar singularidades matemáticas en la diagonal (autointeracción nula)
    np.fill_diagonal(distancias_sq, np.inf)
    distancias = np.sqrt(distancias_sq)

    # 4.2 Construcción del Tensor de Acoplamiento Dipolar T
    # T_ij = (3 * r_ij \otimes r_ij - r_ij^2 * I) / r_ij^5
    T_tensor = np.zeros((num_atomos, num_atomos, 3, 3))
    
    # Operación tensorial óptima sin bucles (np.einsum)
    r_outer = np.einsum('ijk,ijl->ijkl', diferencias, diferencias)
    identidad = np.eye(3)[np.newaxis, np.newaxis, :, :]
    
    # Aplicación de factor de amortiguamiento (Damping) para repulsiones a corto alcance
    amortiguamiento = (1.0 - np.exp(-C * distancias))[:, :, np.newaxis, np.newaxis]
    
    # Formulación matemática del tensor de perturbación
    T_tensor = (3.0 * r_outer - distancias_sq[:, :, np.newaxis, np.newaxis] * identidad) / \
               (distancias[:, :, np.newaxis, np.newaxis]**5)
    T_tensor = T_tensor * amortiguamiento

    # 4.3 Mapeo al Hamiltoniano y Diagonalización
    # Expansión de la matriz acoplada al espacio de fase de 3N x 3N dimensiones
    matriz_T_3N = T_tensor.transpose(0, 2, 1, 3).reshape(3 * num_atomos, 3 * num_atomos)
    
    # Diagonalización optimizada (eigh) para matrices simétricas reales
    eigenvalores, _ = np.linalg.eigh(matriz_T_3N)
    
    # 4.4 Cálculo del Corrimiento Espectral MBD
    # La corrección MBD equivale a la diferencia entre los eigenvalores acoplados y los libres
    energia_cero = 0.5 * OMEGA_0 * (3 * num_atomos)
    energia_acoplada = np.sum(0.5 * OMEGA_0 * np.sqrt(np.abs(1.0 + ALPHA_0 * eigenvalores)))
    
    delta_E_mbd = energia_acoplada - energia_cero
    return delta_E_mbd

# ------------------------------------------------------------------------------
# 5. EJECUCIÓN DEL CÁLCULO ESPECTRAL
# ------------------------------------------------------------------------------
def ejecutar_fase_mbd():
    resultados_mbd = []
    
    for polieno in POLIENOS:
        for config in CONFIGURACIONES:
            ruta_trabajo = f"{RUTA_RAIZ}/{polieno}_Tesis_Master/Topologias_{config}"
            archivo_pdb = f"{ruta_trabajo}/estado_relajado_{config}.pdb"
            
            if os.path.exists(archivo_pdb):
                pdb = app.PDBFile(archivo_pdb)
                posiciones = pdb.positions
                
                # Aislamiento de la subestructura cuántica y evaluación del tensor
                coordenadas_pi = extraer_esqueleto_conjugado(pdb.topology, posiciones)
                energia_mbd = calcular_energia_mbd(coordenadas_pi)
                
                resultados_mbd.append({
                    'Molecula': polieno,
                    'Configuracion': config,
                    'dE_MBD': energia_mbd
                })
    
    # Consolidación estructurada de los datos espectrales calculados
    if resultados_mbd:
        df_mbd = pd.DataFrame(resultados_mbd)
        ruta_salida = f"{RUTA_RAIZ}/resultados_cuanticos_mbd.csv"
        df_mbd.to_csv(ruta_salida, index=False)

ejecutar_fase_mbd()
