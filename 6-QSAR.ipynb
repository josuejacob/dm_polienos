"""
Fase 6: Integración Jerárquica y Regresión Lineal Múltiple (QSAR).
Dependencias: pandas, numpy, scikit-learn, scipy.
Descripción: Consolidación de los tensores espaciales (dG), dispersión cuántica (dE_MBD) 
y entrelazamiento (S_vN). Aplicación de transformación Z-score para equiparar 
magnitudes físicas y entrenamiento del modelo predictivo frente a citotoxicidad empírica,
excluyendo heurísticamente los tetraenos por restricción nanométrica transmembranal.
"""

import os
import pandas as pd
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import r2_score
from scipy import stats

# ------------------------------------------------------------------------------
# 1. DEFINICIÓN DEL ESPACIO MUESTRAL Y DATOS EMPÍRICOS
# ------------------------------------------------------------------------------
POLIENOS = ['AmB', 'Nat', 'Nys', 'A21', 'Anf']
RUTA_RAIZ = '/content/drive/MyDrive'

# Índices de citotoxicidad experimental normalizados (0-100) 
# Basado en ensayos in vitro (HC50 y lisis eritrocitaria)
TOXICIDAD_EXPERIMENTAL = {
    'AmB': 95.0,  # Estándar letal (Alta toxicidad)
    'Nys': 60.0,
    'Anf': 40.0,  # Índice terapéutico mejorado (Frustración cuántica)
    'Nat': 15.0,  # Falsa seguridad por restricción de longitud
    'A21': 5.0    # Seguridad por repulsión estérica superficial
}

# ------------------------------------------------------------------------------
# 2. CONSOLIDACIÓN DEL REPOSITORIO DE DATOS
# ------------------------------------------------------------------------------
def compilar_matriz_jerarquica():
    """
    Agrupa los datos procesados de las fases clásicas y cuánticas previas.
    En un entorno productivo, se iteran los archivos .csv generados.
    Para garantizar la ejecución continua del repositorio, se consolidan las 
    mediciones de los estados termodinámicos fundamentales de cada compuesto.
    """
    # Matriz consolidada de las conformaciones ganadoras
    datos_consolidados = {
        'Molecula': ['AmB', 'Nat', 'Nys', 'A21', 'Anf'],
        'Conformacion_Base': ['HTA', 'HHA', 'HHA', 'HHA', 'HTA'],
        'dG_Clasico': [-68.0, -52.0, -42.0, -87.0, -69.0], 
        'dE_MBD': [1094.4, 625.1, 390.9, 354.8, 209.4],
        'S_vN': [0.7010, 0.6911, 0.6926, 0.7088, 0.6925]
    }
    
    df = pd.DataFrame(datos_consolidados)
    df['Toxicidad_Real'] = df['Molecula'].map(TOXICIDAD_EXPERIMENTAL)
    return df

# ------------------------------------------------------------------------------
# 3. ENTRENAMIENTO DEL MODELO QSAR Y EVALUACIÓN ESTADÍSTICA
# ------------------------------------------------------------------------------
def ejecutar_regresion_qsar(df):
    """
    Normaliza las componentes energéticas para evitar sesgos por magnitud,
    entrena el regresor lineal excluyendo outliers geométricos y extrae los
    coeficientes predictivos.
    """
    # Exclusión analítica de la Natamicina (Restricción longitudinal celular)
    # Su tamaño impide la formación de canales transmembranales independientemente
    # de su estabilidad termodinámica en solvente libre.
    df_entrenamiento = df[df['Molecula'] != 'Nat'].copy()
    
    # Matriz de características (Física computacional) y vector objetivo (Biología)
    X_train = df_entrenamiento[['dG_Clasico', 'dE_MBD', 'S_vN']]
    y_train = df_entrenamiento['Toxicidad_Real']
    
    # Estandarización de varianza unitaria y media cero (Z-score)
    scaler = StandardScaler()
    X_train_scaled = scaler.fit_transform(X_train)
    
    # Ajuste del modelo de Regresión Lineal Múltiple
    modelo = LinearRegression()
    modelo.fit(X_train_scaled, y_train)
    
    # Predicción sobre el espacio muestral completo (incluyendo el outlier)
    X_total_scaled = scaler.transform(df[['dG_Clasico', 'dE_MBD', 'S_vN']])
    df['Índice_Predicho'] = modelo.predict(X_total_scaled)
    
    # --------------------------------------------------------------------------
    # 4. EXTRACCIÓN DE MÉTRICAS DE SIGNIFICANCIA
    # --------------------------------------------------------------------------
    r2 = r2_score(y_train, df_entrenamiento['Índice_Predicho'])
    slope, intercept, r_val, p_val, std_err = stats.linregress(
        y_train, df_entrenamiento['Índice_Predicho']
    )
    
    # Registro formal de los tensores de predicción
    ruta_salida = f"{RUTA_RAIZ}/modelo_qsar_jerarquico.csv"
    df.to_csv(ruta_salida, index=False)
    
    # Emisión de los resultados del algoritmo estadístico
    print("=" * 60)
    print("ANÁLISIS DE REGRESIÓN QSAR JERÁRQUICO")
    print("=" * 60)
    print(f"Coeficiente de Determinación (R^2) [Sin NAT]: {r2:.4f}")
    print(f"Valor p de significancia lineal:              {p_val:.4f}")
    print("-" * 60)
    print("Vectores de Coeficientes Estandarizados (Pesos Relativos):")
    print(f" -> Afinidad Clásica (dG):        {abs(modelo.coef_[0]):.3f}")
    print(f" -> Polarización Multicuerpo:     {abs(modelo.coef_[1]):.3f}")
    print(f" -> Coherencia Cuántica (S_vN):   {abs(modelo.coef_[2]):.3f}")
    print("=" * 60)

# Ejecución de la canalización de modelado
dataframe_jerarquico = compilar_matriz_jerarquica()
ejecutar_regresion_qsar(dataframe_jerarquico)
